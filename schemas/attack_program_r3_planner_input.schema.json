      "type": "array"
    },
    "compatible_samples": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/RawExampleView"
          },
          {
            "$ref": "#/$defs/StructuredExampleView"
          }
        ]
      },
